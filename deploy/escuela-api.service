[Unit]
Description=ESCUELA - Spring Boot REST
After=network.target mysql.service
Requires=mysql.service

[Service]
User=escuela-api
Group=escuela-api
WorkingDirectory=/opt/escuela
EnvironmentFile=/etc/escuela.env
ExecStart=/usr/bin/java -Xms128m -Xmx512m -jar /opt/escuela/escuela-api.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
